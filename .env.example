# Copy to .env next to docker-compose.yml if you want Compose to pick these up.
# Do not commit .env.

POSTGRES_PASSWORD=replace-with-a-strong-local-password
SECRET_KEY=replace-with-at-least-32-random-characters
# Comma-separated browser origins allowed to call the API with cookies.
# Do not use * — credentialed CORS would let any site read a signed-in file.
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Optional local LLM (Ollama / vLLM / LM Studio). From inside Docker:
# LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_BASE_URL=
LLM_API_KEY=ollama
LLM_MODEL=llama3.1
LLM_TIMEOUT=60

# Optional xAI fallback when LLM_BASE_URL is empty.
DASHBOARD_TOKEN=replace-with-at-least-32-random-characters
APP_ENV=development

# Optional xAI fallback when LLM_BASE_URL is empty.
XAI_API_KEY=
