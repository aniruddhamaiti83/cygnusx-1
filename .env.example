# Copy to .env next to docker-compose.yml if you want Compose to pick these up.
# Do not commit .env.

POSTGRES_PASSWORD=cygnusx1
SECRET_KEY=change-me-in-production

# Optional local LLM (Ollama / vLLM / LM Studio). From inside Docker:
# LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_BASE_URL=
LLM_API_KEY=ollama
LLM_MODEL=llama3.1
LLM_TIMEOUT=60

# Optional xAI fallback when LLM_BASE_URL is empty.
XAI_API_KEY=
